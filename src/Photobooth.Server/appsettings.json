{
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Camera": {
    "WatchFolder": {
      "Path": "data/watch",
      "Extensions": [
        ".jpg",
        ".jpeg"
      ],
      "StabilityPollMilliseconds": 150,
      "StabilityChecks": 3,
      "CompletionTimeoutMilliseconds": 15000,
      "SweepIntervalMilliseconds": 2000,
      "MinimumFileSizeBytes": 1024
    },
    "Mock": {
      "SourceFolder": "samples",
      "FileNameFormat": "IMG_{0:0000}.JPG",
      "StartIndex": 1,
      "ChunkBytes": 65536,
      "ChunkDelayMilliseconds": 25
    }
  },
  "Session": {
    "CountdownSeconds": 3,
    "NoPhotoTimeoutSeconds": 20
  },
  "Templates": {
    "Folder": "templates",
    "Selected": "classic-2x6"
  },
  "Archive": {
    "Folder": "data/sessions",
    "LowDiskWarningBytes": 2147483648
  }
}
