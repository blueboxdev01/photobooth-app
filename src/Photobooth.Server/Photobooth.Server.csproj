<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Photobooth.Core\Photobooth.Core.csproj" />
    <ProjectReference Include="..\Photobooth.Cameras\Photobooth.Cameras.csproj" />
    <ProjectReference Include="..\Photobooth.Imaging\Photobooth.Imaging.csproj" />
    <ProjectReference Include="..\Photobooth.Delivery\Photobooth.Delivery.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Sample photos for MockEosUtility. Copied next to the app so a published
       build can run a full mock session on a machine with no camera. -->
  <ItemGroup>
    <Content Include="..\..\samples\*.jpg" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\templates\*" Link="templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- Put wwwroot next to the built app, matching the layout `dotnet publish`
       produces, so running the DLL directly behaves the same as a released build. -->
  <Target Name="CopyWwwrootToOutput" AfterTargets="Build">
    <ItemGroup>
      <WwwrootFiles Include="wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <Version>0.6.0</Version>
  </PropertyGroup>

  <!-- Stamp the commit into the assembly so the UI can show exactly which build
       produced a result. Debugging a remote field test without knowing which
       version the tester ran is close to impossible. -->
  <Target Name="StampBuildInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short=8 HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ResolvedGitSha" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <PropertyGroup>
      <ResolvedGitSha Condition="'$(GitExitCode)' != '0' or '$(ResolvedGitSha)' == ''">unknown</ResolvedGitSha>
      <InformationalVersion>$(Version)+$(ResolvedGitSha)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
